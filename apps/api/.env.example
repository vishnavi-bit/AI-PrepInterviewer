# Copy this file to .env and fill in real values. The .env file is git-ignored; never commit it.

# Signs login sessions. Required. Use a random string of at least 32 characters, different in production.
JWT_SECRET=

# Local development database (a libSQL file). Use libsql://... and DATABASE_AUTH_TOKEN for Turso.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Where uploaded resume files are stored. Defaults to ./uploads (git-ignored).
UPLOADS_DIR=./uploads

# Google Gemini. Leave GEMINI_API_KEY empty to use the built-in offline analysis for development.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# HTTP port for the API (the web app's proxy points at this port).
PORT=3000

# Email (welcome, password reset, password-changed). Required for "Forgot Password" to work.
# Use your SMTP provider's host and credentials. The From address must be allowed by that provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI PrepInterviewer <no-reply@your-domain.example>"

# Public address of the web app. Used to build the link in reset emails.
APP_BASE_URL=http://localhost:5173
