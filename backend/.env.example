# Copy to backend/.env (ignored by git) and fill in. Leave TURSO_* empty to use a local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LOCAL_DB_PATH=data/app.db
UPLOADS_DIR=uploads
# Resume files (PDF/DOCX) are kept here, outside the database. Defaults to UPLOADS_DIR/resumes.
RESUMES_DIR=uploads/resumes
# Largest accepted resume, in bytes (5 MB by default).
RESUME_MAX_BYTES=5242880
# Gemini resume analysis. Called by the backend only. Leave GEMINI_API_KEY empty to disable analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
SESSION_DAYS=7
# Keep true in deployment (HTTPS only). Set to false only for plain-http local testing.
COOKIE_SECURE=true
