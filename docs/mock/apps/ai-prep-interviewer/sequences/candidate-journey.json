        "choose-role": {
          "performedText": "chose the Python Developer role",
          "nextStep": "interview-config",
          "stateChange": { "roles.selected": { "set": "Python Developer" } }
        }
      }
    },
    "interview-config": {
      "user": "candidate",
      "screen": "S07",
      "proposedAction": "Review the settings and click Start interview",
      "infoPanel": [
        { "key": "roles.selected", "label": "Role" },
        { "key": "interview.duration", "label": "Duration" }
      ],
      "actions": {
        "start-interview": {
          "performedText": "started the interview",
          "nextStep": "room-q1",
          "stateChange": {
            "interview.status": { "set": "in progress" },
            "interview.avatar": { "set": "speaking" }
          }
        }
      }
    },
    "room-q1": {
      "user": "candidate",
      "screen": "S08",
      "proposedAction": "Answer question 1 and click Submit answer",
      "infoPanel": [{ "key": "interview.answersSaved", "label": "Answers saved" }],
      "actions": {
        "submit-answer": {
          "performedText": "submitted an answer to question 1",
          "nextStep": "room-followup",
          "stateChange": {
            "interview.answersSaved": 1,
            "interview.isFollowUp": { "set": true },
            "interview.question": { "copy": "interview.followUp" },
            "interview.avatar": { "set": "speaking" }
          }
        }
      }
    },
    "room-followup": {
      "user": "candidate",
      "screen": "S08",
      "proposedAction": "Answer the follow-up and click Submit answer",
      "infoPanel": [{ "key": "interview.answersSaved", "label": "Answers saved" }],
      "actions": {
        "submit-answer": {
          "performedText": "answered the follow-up question",
          "nextStep": "room-q2",
          "stateChange": {
            "interview.answersSaved": 1,
            "interview.isFollowUp": { "set": false },
            "interview.questionNo": 1,
            "interview.question": { "copy": "interview.nextQuestion" }
          }
        }
      }
    },
    "room-q2": {
      "user": "candidate",
      "screen": "S08",
      "proposedAction": "Answer question 2 and click Submit answer",
      "infoPanel": [{ "key": "interview.answersSaved", "label": "Answers saved" }],
      "actions": {
        "submit-answer": {
          "performedText": "submitted the last answer",
          "nextStep": "interview-complete",
          "stateChange": {
            "interview.answersSaved": 1,
            "interview.status": { "set": "completed" },
            "interview.avatar": { "set": "idle" }
          }
        }
      }
    },
    "interview-complete": {
      "user": "candidate",
      "screen": "S08",
      "proposedAction": "Click View report",
      "actions": {
        "view-report": { "performedText": "opened the report", "nextStep": "result" }
      }
    },
    "result": {
      "user": "candidate",
      "screen": "S09",
      "proposedAction": "Read the report and click Back",
      "actions": {
        "back": {
          "performedText": "read the report and went back",
          "nextStep": "dashboard-after",
          "stateChange": {
            "history.completed": 1,
            "history.lastScore": { "copy": "report.overall" },
            "history.recent": { "copy": "report.recent" }
          }
        }
      }
    },
    "dashboard-after": {
      "user": "candidate",
      "screen": "S04",
