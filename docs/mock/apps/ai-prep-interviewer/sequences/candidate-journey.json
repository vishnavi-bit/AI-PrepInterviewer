      "performedText": "waited for the analysis",
      "stateChange": { "resume.status": { "set": "analysed" } },
      "nextStep": "resume-review"
    },
    "resume-review": {
      "user": "candidate",
      "screen": "S05",
      "proposedAction": "Check the extracted information and click Confirm",
      "actions": {
        "confirm": { "performedText": "confirmed the extracted information", "nextStep": "roles" }
      }
    },
    "roles": {
      "user": "candidate",
      "screen": "S06",
      "proposedAction": "Choose a role and click Choose this role",
